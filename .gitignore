# build output
/build/
/build-*/

# a vcpkg clone in the project root is one of the locations the Windows
# configure scripts look in, so it must not show up as untracked
/vcpkg/

# scratch / generated artifacts (meshes, latents, occupancy grids)
/tmp/
*.o
*.a
*.so
*.dylib
*.dll

# cmake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# model weights / data (large, regenerated by the converters)
*.gguf
*.safetensors
*.dinodata
*.latent
*.occ
*.obj

# test reference artifacts (regenerated by tests/ref_*.py)
tests/ss_flow_ref.bin
tests/ss_sample_ref.bin
tests/ss_dec_ref.bin

# editor / os
.DS_Store
.vscode/
.idea/

# clangd index
.cache/
corpus_*/
crash-*

# fuzzing
/corpus_*/
crash-*

# demo server build artifacts
/server/trellis2-server
/server/trellis2-server-linux
/server/vendor/

# model / reference artifacts
/models/
/ggufs/
/dumps/
/generations/
# Local checkout of the upstream TRELLIS.2 Python package, copied here so
# scripts/ref_*.py can import it. MIT-licensed, but reference material we run
# against — never adopted into our sources, so it stays out of the tree.
/trellis2/
slow-unit-*
assets/
data_toolkit/
*.log

server/trellis2-server.exe

# --- rob-project-template ---
# Rust
target/
Cargo.lock

# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/
uv.lock

# Misc
.yek/
/assets
/logs
/temp
docs/ideas/*
!docs/ideas/.gitkeep
docs/bugs/*
!docs/bugs/.gitkeep
docs/screenshots/*
!docs/screenshots/.gitkeep
profile.json*
